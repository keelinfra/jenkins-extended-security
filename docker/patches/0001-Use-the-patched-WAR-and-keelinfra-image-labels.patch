From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xianpeng <3353385+shenxianpeng@users.noreply.github.com>
Date: Thu, 5 Nov 2026 07:34:06 +0000
Subject: [PATCH] Use the patched WAR and keelinfra image labels

The WAR comes from the build context and is checked against its sha256
instead of being downloaded from get.jenkins.io and checked with the
Jenkins release key. The labels no longer say this is the official image.
---
 debian/Dockerfile | 29 ++++++++++-------------------
 1 file changed, 10 insertions(+), 19 deletions(-)

diff --git a/debian/Dockerfile b/debian/Dockerfile
index feb8ccb..d04b913 100644
--- a/debian/Dockerfile
+++ b/debian/Dockerfile
@@ -45,19 +45,10 @@ RUN java_major_version="$(jlink --version 2>&1 | cut -c1-2)"; \
         --output /javaruntime; \
     fi
 
-# Jenkins version being bundled in this docker image
-ARG JENKINS_VERSION=2.544
-# Can be used to customize where jenkins.war get downloaded from
-ARG WAR_URL=https://get.jenkins.io/war/${JENKINS_VERSION}/jenkins.war
-
-COPY jenkins.io-2026.key /war/jenkins-key.pub
-
-# Not using ADD as it does not check Last-Modified header
-# see https://github.com/docker/docker/issues/8331
-RUN curl -fsSL "${WAR_URL}" -o /war/jenkins.war \
-  && curl -fsSL "${WAR_URL}.asc" -o /war/jenkins.war.asc \
-  && gpg --import /war/jenkins-key.pub \
-  && gpg --verify --trust-model direct /war/jenkins.war.asc /war/jenkins.war
+# The patched WAR from the build context, checked against its sha256
+ARG WAR_SHA256
+COPY jenkins.war /war/jenkins.war
+RUN echo "${WAR_SHA256}  /war/jenkins.war" | sha256sum -c --strict
 
 FROM debian:"${DEBIAN_RELEASE_LINE}-${DEBIAN_VERSION}${DEBIAN_VARIANT}" AS controller
 
@@ -151,17 +142,17 @@ COPY jenkins-support /usr/local/bin/jenkins-support
 COPY jenkins.sh /usr/local/bin/jenkins.sh
 COPY jenkins-plugin-cli.sh /bin/jenkins-plugin-cli
 
-ARG JENKINS_VERSION=2.544
+ARG JENKINS_VERSION
 
 ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/jenkins.sh"]
 
 # metadata labels
 LABEL \
-    org.opencontainers.image.vendor="Jenkins project" \
-    org.opencontainers.image.title="Official Jenkins Docker image" \
-    org.opencontainers.image.description="The Jenkins Continuous Integration and Delivery server" \
+    org.opencontainers.image.vendor="keelinfra" \
+    org.opencontainers.image.title="Extended Security for Jenkins" \
+    org.opencontainers.image.description="Jenkins with core security fixes backported. Not an official Jenkins image." \
     org.opencontainers.image.version="${JENKINS_VERSION}" \
-    org.opencontainers.image.url="https://www.jenkins.io/" \
-    org.opencontainers.image.source="https://github.com/jenkinsci/docker" \
+    org.opencontainers.image.url="https://github.com/keelinfra/jenkins-extended-security" \
+    org.opencontainers.image.source="https://github.com/keelinfra/jenkins-extended-security" \
     org.opencontainers.image.revision="${COMMIT_SHA}" \
     org.opencontainers.image.licenses="MIT"
