+        alice.addProperty(new TimeZoneProperty(TIME_ZONE));
+        alice.save();
+
+        try (JenkinsRule.WebClient wc = j.createWebClient().withThrowExceptionOnFailingStatusCode(false)) {
+            wc.login("bob");
