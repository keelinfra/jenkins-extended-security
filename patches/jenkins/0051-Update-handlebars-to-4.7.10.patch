From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xianpeng <3353385+shenxianpeng@users.noreply.github.com>
Date: Wed, 18 Nov 2026 18:12:25 +0000
Subject: [PATCH] Update handlebars to 4.7.10

Not a cherry-pick: upstream made this update in two steps,
3aff301a4f (4.7.9, #26531) and 5ad1bcfd5b (4.7.10, #27510, in 2.580.2),
whose yarn.lock hunks do not apply to 2.541.3. Same package.json change;
yarn.lock regenerated with Yarn 4.12.0 (yarn install
--mode=update-lockfile), and its handlebars entry matches 2.580.2's,
checksum included. 4.7.10 fixes GHSA-2w6w-674q-4c4q, GHSA-3mfm-83xf-c92r,
GHSA-xhpv-hc6g-r9c6, GHSA-9cx6-37pm-9jff, GHSA-xjpj-3mr7-gcpf,
GHSA-2qvq-rjwj-gvw9, GHSA-442j-39wm-28r2, GHSA-7rx3-28cr-v5wh (4.7.9) and
GHSA-8r5x-fm3f-whwj, GHSA-p8wg-vrv2-v86f, GHSA-xw65-4hp5-5hc7 (4.7.10).
---
 package.json |  2 +-
 yarn.lock    | 14 +++++++-------
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/package.json b/package.json
index 4f7f660639..c892972f11 100644
--- a/package.json
+++ b/package.json
@@ -53,7 +53,7 @@
     "webpack-remove-empty-scripts": "1.1.1"
   },
   "dependencies": {
-    "handlebars": "4.7.8",
+    "handlebars": "4.7.10",
     "hotkeys-js": "3.12.2",
     "jquery": "3.7.1",
     "lodash": "4.17.21",
diff --git a/yarn.lock b/yarn.lock
index 93e5a9d3db..d378f28bf2 100644
--- a/yarn.lock
+++ b/yarn.lock
@@ -4120,11 +4120,11 @@ __metadata:
   languageName: node
   linkType: hard
 
-"handlebars@npm:4.7.8":
-  version: 4.7.8
-  resolution: "handlebars@npm:4.7.8"
+"handlebars@npm:4.7.10":
+  version: 4.7.10
+  resolution: "handlebars@npm:4.7.10"
   dependencies:
-    minimist: "npm:^1.2.5"
+    minimist: "npm:^1.2.8"
     neo-async: "npm:^2.6.2"
     source-map: "npm:^0.6.1"
     uglify-js: "npm:^3.1.4"
@@ -4134,7 +4134,7 @@ __metadata:
       optional: true
   bin:
     handlebars: bin/handlebars
-  checksum: 10c0/7aff423ea38a14bb379316f3857fe0df3c5d66119270944247f155ba1f08e07a92b340c58edaa00cfe985c21508870ee5183e0634dcb53dd405f35c93ef7f10d
+  checksum: 10c0/9b5573584ae5836172ae3f1502d9819568ba1b92ee83b81b18223beeb4c07486595e7b0fa633102beabc66ed06fe6e7da1dd9a9ea8c7072b9550b9a88809165c
   languageName: node
   linkType: hard
 
@@ -4466,7 +4466,7 @@ __metadata:
     eslint-config-prettier: "npm:10.1.8"
     eslint-formatter-checkstyle: "npm:9.0.1"
     globals: "npm:16.5.0"
-    handlebars: "npm:4.7.8"
+    handlebars: "npm:4.7.10"
     handlebars-loader: "npm:1.7.3"
     hotkeys-js: "npm:3.12.2"
     jquery: "npm:3.7.1"
@@ -4953,7 +4953,7 @@ __metadata:
   languageName: node
   linkType: hard
 
-"minimist@npm:^1.2.0, minimist@npm:^1.2.5":
+"minimist@npm:^1.2.0, minimist@npm:^1.2.8":
   version: 1.2.8
   resolution: "minimist@npm:1.2.8"
   checksum: 10c0/19d3fcdca050087b84c2029841a093691a91259a47def2f18222f41e7645a0b7c44ef4b40e88a1e58a40c84d2ef0ee6047c55594d298146d0eb3f6b737c20ce6
-- 
